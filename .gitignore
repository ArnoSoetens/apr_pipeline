# Data & cache
# data/ is not tracked, except the project settings and host files in data/inputs/
data/*
!data/inputs/
data/inputs/*
!data/inputs/config.toml
!data/inputs/BCD.frcmod
!data/inputs/BCD.mol2
!data/inputs/BCD.pdb
data_previous_runs/
previous_data/
__pycache__/
*.pyc

# HPC & Slurm logs (scripts/job_array.slurm is tracked anyway)
*.slurm
!scripts/job_gpu.slurm
*.out
*.err

# Environment & IDE
.env
.venv/
env/
.vscode/
.DS_Store

# Other
*.mjs
other/
