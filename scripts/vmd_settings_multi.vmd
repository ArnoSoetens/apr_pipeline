# vmd_settings_multi.vmd
#
# Defines apply_window_reps, called once per loaded molecule by
# open_windows.sh (via the generated load script) after all molecules
# are read in. Edit the representation block below to change how every
# window is drawn.

proc apply_window_reps {molid} {
    # Remove any default rep so we control everything explicitly
    mol delrep 0 $molid

    # --- Representation 0: whole system, default look ---
    mol representation Lines
    mol color Name
    mol selection "all"
    mol material Opaque
    mol addrep $molid

    # --- Representation 1: Licorice highlight on index 147 to 190 ---
    mol representation Licorice 0.3 12.0 12.0
    mol color Name
    mol selection "index 147 to 190"
    mol material Opaque
    mol addrep $molid
}

proc apply_complex_reps {molid} {
    mol delrep 0 $molid

    mol representation Lines
    mol color Name
    mol selection "all"
    mol material Opaque
    mol addrep $molid

    mol representation Licorice 0.3 12.0 12.0
    mol color Name
    mol selection "index 147 to 190"
    mol material Opaque
    mol addrep $molid
}

proc apply_clash_reps {molid guest_atom_index} {
    mol delrep 0 $molid

    mol representation Lines
    mol color Name
    mol selection "all"
    mol material Opaque
    mol addrep $molid

    mol representation Licorice 0.3 12.0 12.0
    mol color Name
    mol selection "index $guest_atom_index"
    mol material Opaque
    mol addrep $molid
}

# --- Global display settings (applied once, not per molecule) ---
display projection Orthographic
display depthcue off
color Display Background white
color Labels Bonds black
axes location Off
animate style Loop

# Playback speed slider (Extensions > Analysis > Animate window) ranges
# from -1.0 (slowest) to 1.0 (fastest), with 0.0 the default middle.
animate speed 0.75

# By default VMD shows every loaded molecule at once, which gets crowded
# fast with several windows stacked in the same view. This hides all but
# the first-loaded molecule so you see one window at a time.
proc hide_all_but_first {} {
    set mols [molinfo list]
    if {[llength $mols] < 2} { return }
    set first [lindex $mols 0]
    foreach m $mols {
        if {$m != $first} {
            mol off $m
        }
    }
}

# ---------------------------------------------------------------------------
# Arrow-key molecule cycling
#
# Right arrow  -> show next molecule  (wraps around)
# Left arrow   -> show previous molecule
#
# In --failed-clashes mode the host PDB is loaded as molecule 0 and must
# stay visible at all times. Call  set_cycle_offset 1  from the load script
# to skip it; the default of 0 cycles all molecules.
#
# Keys are bound to the OpenGL display window; click the 3D viewport
# once to give it focus if the arrows are not responding.
# ---------------------------------------------------------------------------

# How many leading molecules to leave alone (0 = cycle everything).
set _mol_cycle_offset 0

proc set_cycle_offset {n} {
    global _mol_cycle_offset
    set _mol_cycle_offset $n
}

proc _mol_show_index {idx} {
    global _mol_cycle_offset
    set mol_list [molinfo list]
    set n [llength $mol_list]
    set cycleable [expr {$n - $_mol_cycle_offset}]
    if {$cycleable <= 0} return

    # Wrap-around within the cycleable range
    set idx [expr {$idx % $cycleable}]

    # Hide all cycleable molecules, leave the offset ones untouched
    foreach molid [lrange $mol_list $_mol_cycle_offset end] {
        mol off $molid
    }
    set target [lindex $mol_list [expr {$_mol_cycle_offset + $idx}]]
    mol on  $target
    mol top $target
    puts "Molecule $idx / [expr {$cycleable - 1}]: [molinfo $target get name]"
}

proc _mol_current_index {} {
    global _mol_cycle_offset
    set mol_list [molinfo list]
    set top [molinfo top]
    set abs_idx [lsearch $mol_list $top]
    if {$abs_idx < $_mol_cycle_offset} {
        # top is one of the pinned molecules; default to first cycleable
        return 0
    }
    return [expr {$abs_idx - $_mol_cycle_offset}]
}

proc next_mol {} { _mol_show_index [expr {[_mol_current_index] + 1}] }
proc prev_mol {} { _mol_show_index [expr {[_mol_current_index] - 1}] }

user add key Right { next_mol }
user add key Left  { prev_mol }
user add key Up   { animate goto [expr {[molinfo top get frame] - 1}] }
user add key Down { animate goto [expr {[molinfo top get frame] + 1}] }
user add key J    { animate speed [expr {max(-1.0, [animate speed] - 0.1)}] }
user add key L    { animate speed [expr {min( 1.0, [animate speed] + 0.1)}] }