# vmd_settings_multi.vmd
#
# Defines apply_window_reps, called once per loaded molecule by
# open_windows.sh (via the generated load script) after all molecules
# are read in. Edit the representation block below to change how every
# window is drawn.

proc apply_window_reps {molid} {
    # Remove any default rep so we control everything explicitly
    mol delrep 0 $molid

    # --- Representation 0: whole system, default look ---
    mol representation Lines
    mol color Name
    mol selection "all"
    mol material Opaque
    mol addrep $molid

    # --- Representation 1: Licorice highlight on index 147 to 190 ---
    mol representation Licorice 0.3 12.0 12.0
    mol color Name
    mol selection "index 147 to 190"
    mol material Opaque
    mol addrep $molid
}

proc apply_complex_reps {molid} {
    mol delrep 0 $molid

    mol representation Lines
    mol color Name
    mol selection "all"
    mol material Opaque
    mol addrep $molid

    mol representation Licorice 0.3 12.0 12.0
    mol color Name
    mol selection "index 147 to 190"
    mol material Opaque
    mol addrep $molid
}

proc apply_clash_reps {molid guest_atom_index} {
    mol delrep 0 $molid

    mol representation Lines
    mol color Name
    mol selection "all"
    mol material Opaque
    mol addrep $molid

    mol representation Licorice 0.3 12.0 12.0
    mol color Name
    mol selection "index $guest_atom_index"
    mol material Opaque
    mol addrep $molid
}

# --- Global display settings (applied once, not per molecule) ---
display projection Orthographic
display depthcue off
color Display Background white
axes location Off
animate style Loop

# Playback speed slider (Extensions > Analysis > Animate window) ranges
# from -1.0 (slowest) to 1.0 (fastest), with 0.0 the default middle.
# Set to 25% of that range: -0.5
animate speed 0.25

# By default VMD shows every loaded molecule at once, which gets crowded
# fast with several windows stacked in the same view. This hides all but
# the first-loaded molecule so you see one window at a time; use the
# Molecule menu (double-click the "D" column) to toggle visibility for
# whichever window you want to inspect, or use the VMD Main window's
# molecule list to step through them.
proc hide_all_but_first {} {
    set mols [molinfo list]
    if {[llength $mols] < 2} { return }
    set first [lindex $mols 0]
    foreach m $mols {
        if {$m != $first} {
            mol off $m
        }
    }
}

# ---------------------------------------------------------------------------
# Arrow-key molecule cycling
#
# Right arrow  -> show next molecule  (wraps around)
# Left arrow   -> show previous molecule
#
# Keys are bound to the OpenGL display window; click the 3D viewport
# once to give it focus if the arrows are not responding.
# ---------------------------------------------------------------------------

proc _mol_show_index {idx} {
    set mol_list [molinfo list]
    set n [llength $mol_list]
    if {$n == 0} return

    # Wrap-around index
    set idx [expr {$idx % $n}]

    # Hide all, then show only the target
    foreach molid $mol_list {
        mol off $molid
    }
    set target [lindex $mol_list $idx]
    mol on  $target
    mol top $target
    display resetview
    puts "Molecule $idx / [expr {$n - 1}]: [molinfo $target get name]"
}

proc _mol_current_index {} {
    set mol_list [molinfo list]
    set top [molinfo top]
    set idx [lsearch $mol_list $top]
    # Fallback: scan for the first drawn molecule if top isn't in the list
    if {$idx < 0} {
        set idx 0
        foreach molid $mol_list {
            if {[molinfo $molid get drawn]} { break }
            incr idx
        }
    }
    return $idx
}

proc next_mol {} { _mol_show_index [expr {[_mol_current_index] + 1}] }
proc prev_mol {} { _mol_show_index [expr {[_mol_current_index] - 1}] }

user add key Right { next_mol }
user add key Left  { prev_mol }
